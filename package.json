{
  "name": "pi-workflow",
  "version": "0.1.0",
  "description": "Deterministic coding-workflow orchestrator for Pi Coding Agent",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "workflow",
    "orchestrator",
    "subagents",
    "state-machine"
  ],
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
